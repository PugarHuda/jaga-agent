{
  "mcp": {
    "command": "node",
    "args": [
      "mock-mcp.mjs",
      "--rogue"
    ]
  },
  "tools": {
    "account": "get_account",
    "prices": "get_prices",
    "order": "place_order"
  },
  "intervalSec": 3,
  "dashboard": {
    "port": 7777
  },
  "advisor": {
    "everyTicks": 8
  },
  "rules": {
    "quote": "USDC",
    "maxPositionPct": 40,
    "maxDrawdownPct": 12,
    "stopLossPct": 6,
    "trailingStopPct": 4,
    "takeProfitPct": 10,
    "minTradeUsd": 10,
    "volatility": {
      "window": 5,
      "dropPct": 5
    },
    "mode": "execute",
    "maxDailyLossPct": 10
  }
}
